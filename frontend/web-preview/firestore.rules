rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Private: plan, check-ins and gear — only the owner.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Public "My gear" page: anyone can read, only the owner can write or delete.
    match /profiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.data.keys().hasOnly(['name', 'photoURL', 'race', 'gear', 'updatedAt'])
                   && request.resource.data.gear.size() <= 50;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
